{
  "name": "node-typescript-api",
  "version": "1.0.0",
  "engines": {
    "node": ">21.5.0"
  },
  "type": "commonjs",
  "description": "",
  "main": "index.js",
  "scripts": {
    "postinstall": "rm -rf node_modules/@xenova/transformers/node_modules/sharp 2>/dev/null || true",
    "start": "touch .env && swc src -d dist --strip-leading-paths && ORT_LOG_LEVEL=0 node --env-file=.env --env-file=.development.env dist/index.js 2>&1 | grep -v CleanUnusedInitializersAndNodeArgs",
    "start:dev": "touch .env && swc src -d dist --strip-leading-paths && ORT_LOG_LEVEL=0 node --env-file=.env --env-file=.development.env dist/index.js 2>&1 | grep -v CleanUnusedInitializersAndNodeArgs",
    "start:prod": "touch .env && swc src -d dist --strip-leading-paths && ORT_LOG_LEVEL=0 node --max-old-space-size=4096 --env-file=.env --env-file=.production.env dist/index.js 2>&1 | grep -v CleanUnusedInitializersAndNodeArgs",
    "dev": "concurrently \"swc src -d dist --strip-leading-paths -wq\" \"ORT_LOG_LEVEL=0 node dist/index.js 2>&1 | grep -v CleanUnusedInitializersAndNodeArgs\"",
    "build": "npm install --legacy-peer-deps --include=dev && swc src -d dist --strip-leading-paths",
    "test": "vitest --config ./vitest.config.mjs",
    "security:check": "node scripts/security-check.mjs",
    "test:setup": "ts-node src/test/setup.ts",
    "test:watch": "vitest --config ./vitest.config.mjs --watch",
    "test:coverage": "vitest --config ./vitest.config.mjs --coverage",
    "mcp:ember": "node src/mcp/emberMcpServer.mjs",
    "mcp:ember:smoke": "node src/mcp/smokeTest.mjs",
    "relationships:rebuild:dry": "TS_NODE_TRANSPILE_ONLY=1 npx ts-node src/scripts/rebuildRelationshipsFromMoments.ts",
    "relationships:rebuild:apply": "TS_NODE_TRANSPILE_ONLY=1 npx ts-node src/scripts/rebuildRelationshipsFromMoments.ts --apply",
    "relationships:dedup:dry": "TS_NODE_TRANSPILE_ONLY=1 npx ts-node src/scripts/dedupExistingRelationships.ts",
    "relationships:dedup:apply": "TS_NODE_TRANSPILE_ONLY=1 npx ts-node src/scripts/dedupExistingRelationships.ts --write",
    "relationships:moment-ids:dry": "TS_NODE_TRANSPILE_ONLY=1 npx ts-node src/scripts/backfillRelationshipMomentIds.ts",
    "relationships:moment-ids:apply": "TS_NODE_TRANSPILE_ONLY=1 npx ts-node src/scripts/backfillRelationshipMomentIds.ts --write",
    "migrate:final-why:dry": "TS_NODE_TRANSPILE_ONLY=1 npx ts-node src/scripts/migrateFinalWhy.ts",
    "migrate:final-why:apply": "TS_NODE_TRANSPILE_ONLY=1 npx ts-node src/scripts/migrateFinalWhy.ts --apply",
    "s3:migrate-assets:dry": "TS_NODE_TRANSPILE_ONLY=1 npx ts-node src/scripts/migrateS3Assets.ts",
    "s3:migrate-assets:apply": "TS_NODE_TRANSPILE_ONLY=1 npx ts-node src/scripts/migrateS3Assets.ts --apply",
    "s3:normalize-extensions:dry": "TS_NODE_TRANSPILE_ONLY=1 npx ts-node src/scripts/normalizeImageExtensions.ts",
    "s3:normalize-extensions:apply": "TS_NODE_TRANSPILE_ONLY=1 npx ts-node src/scripts/normalizeImageExtensions.ts --apply",
    "s3:migrate-webp:dry": "TS_NODE_TRANSPILE_ONLY=1 npx ts-node src/scripts/migrateToWebP.ts",
    "s3:migrate-webp:apply": "TS_NODE_TRANSPILE_ONLY=1 npx ts-node src/scripts/migrateToWebP.ts --apply",
    "mongo:migrate:reset-and-copy:dry": "TS_NODE_TRANSPILE_ONLY=1 npx ts-node src/scripts/migrateS3Assets.ts --mongo-only --clear-target",
    "mongo:migrate:reset-and-copy": "TS_NODE_TRANSPILE_ONLY=1 npx ts-node src/scripts/migrateS3Assets.ts --mongo-only --clear-target --apply",
    "users:dob-backfill": "TS_NODE_TRANSPILE_ONLY=1 npx ts-node src/scripts/backfillUserDateOfBirthFromCsv.ts",
    "users:remove-non-test:dry": "TS_NODE_TRANSPILE_ONLY=1 npx ts-node src/scripts/removeNonTestUsers.ts --dry",
    "users:remove-non-test:apply": "TS_NODE_TRANSPILE_ONLY=1 npx ts-node src/scripts/removeNonTestUsers.ts --apply",
    "moments:image-urls:normalize:dry": "TS_NODE_TRANSPILE_ONLY=1 npx ts-node src/scripts/normalizeMomentImageUrls.ts",
    "moments:image-urls:normalize:apply": "TS_NODE_TRANSPILE_ONLY=1 npx ts-node src/scripts/normalizeMomentImageUrls.ts --apply",
    "lint": "export NODE_OPTIONS=\"--max-old-space-size=8162\" && eslint --ext .ts src/",
    "lint:fix": "export NODE_OPTIONS=\"--max-old-space-size=8162\" && eslint --ext .ts src/ --fix",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/compat": "^2.0.2",
    "@eslint/eslintrc": "^3.3.4",
    "@eslint/js": "^10.0.1",
    "@swc/cli": "^0.7.10",
    "@swc/core": "^1.15.13",
    "@types/apicache": "^1.6.8",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.17.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitest/ui": "^4.1.5",
    "chokidar": "^4.0.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-standard-with-typescript": "^43.0.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-promise": "^6.1.1",
    "form-data": "^4.0.4",
    "globals": "^17.3.0",
    "jsdom": "^27.0.0",
    "mockingoose": "^2.16.2",
    "nodemon": "^3.1.10",
    "prettier": "^3.0.0",
    "typescript": "^4.9.5",
    "vite": "^7.0.0",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.56.0",
    "@google/genai": "^2.12.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/nodemailer": "^8.0.0",
    "@xenova/transformers": "^2.17.2",
    "apicache": "^1.6.3",
    "aws-sdk": "^2.1693.0",
    "aws-sdk-client-mock": "^2.0.0",
    "axios": "^1.5.1",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dayjs": "^1.11.10",
    "dotenv": "^17.2.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "ioredis-mock": "^8.13.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^6.12.5",
    "morgan": "^1.10.0",
    "multer": "1.4.5-lts.1",
    "nodemailer": "^8.0.6",
    "openai": "^5.12.2",
    "rate-limit-redis": "^4.3.1",
    "sharp": "^0.34.4",
    "socket.io": "^4.7.4",
    "stripe": "^22.1.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "unique-username-generator": "^1.5.1"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.34.4"
    }
  }
}
