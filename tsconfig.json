{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "target": "es2018",
    "moduleResolution": "node",
    "sourceMap": true,
    "outDir": "dist",
    "resolveJsonModule": true,
    "strictNullChecks": true,
    "removeComments": false,
    "lib": [
      "es2018",
      "dom",
      "dom.iterable"
    ],
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "exclude": [
    "node_modules",
    "dist",
    "coverage"
  ]
}